# Server
PORT=3001
NODE_ENV=development
# Debe coincidir con la URL principal del CRM (sin barra final).
# Si también sirves el sitio en el dominio raíz (sin subdominio), agrégalo en CORS_ORIGINS.
FRONTEND_URL=http://localhost:5173
# Orígenes adicionales separados por coma (http/https, con o sin www)
# Ej: https://crm.tudominio.com,https://tudominio.com,http://tudominio.com
CORS_ORIGINS=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexova_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (32 bytes hex for AES-256)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# URL exacta del webhook en la consola Twilio (misma que "When a message comes in")
# Ej: http://TU-IP/api/webhooks/twilio?business=gareva-zenith
TWILIO_WEBHOOK_URL=
# Solo diagnóstico local — nunca en producción
TWILIO_SKIP_SIGNATURE_VALIDATION=false

# Backup
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_GPG_PASSPHRASE=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@nexova.com

# Timezone
TZ=America/Chihuahua

# Facebook Page — publicar propiedades al guardar
FACEBOOK_ENABLED=true
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# URL pública del CRM (para que Facebook descargue fotos). En producción: https://crm.novaarctech.com.mx
PUBLIC_URL=
# FACEBOOK_GRAPH_VERSION=v21.0
# WhatsApp en publicaciones de Facebook (solo dígitos con código de país)
FACEBOOK_WHATSAPP_CONTACT=+525511346655

# Meta Messenger / Instagram — conversaciones en CRM (webhook separado de Twilio/WhatsApp)
META_MESSAGING_ENABLED=true
META_VERIFY_TOKEN=
META_APP_SECRET=
# Si Instagram está en OTRA app de Meta (Gareva_App-IG), pon su App Secret aquí:
# META_IG_APP_SECRET=
# Token de Instagram (Generar token de garevazenith) — para RESPONDER DMs
# INSTAGRAM_ACCOUNT_ID=17841439195463802
# INSTAGRAM_ACCESS_TOKEN=
# META_SKIP_SIGNATURE_VALIDATION=true

# Seed (solo primer despliegue — no guardar la contraseña en este archivo en producción)
# SEED_PASSWORD=
# SEED_OWNER_EMAIL=jorge@nexova.com
# SEED_ADMIN_EMAIL=admin@gareva.mx
# SEED_ASESOR_EMAIL=asesor@gareva.mx
